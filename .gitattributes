# 脚本与机器读取资源固定LF，避免Windows checkout引入命令或匹配差异。
*.sh text eol=lf
*.awk text eol=lf
*.py text eol=lf
*.tsv text eol=lf
.agents/**/*.md text eol=lf
.codex/**/*.toml text eol=lf
.codex/**/*.json text eol=lf
AGENTS.md text eol=lf

# 原始runner输出保留程序产生的空白；仅这些证据日志不作源码空白检查。
studio-tests/results/runtime-evidence/**/*.log -whitespace
studio-tests/results/runtime-evidence/**/*.log.unit -whitespace
studio-tests/results/runtime-evidence/**/*.log.e2e -whitespace
studio-tests/results/runtime-evidence/**/*.tsv -whitespace

# 原始验收归档保留CRLF与输出留白，保持清单SHA；其它文件继续检查源码空白。
studio-tests/results/runtime-evidence/app-core/** -text -whitespace
studio-tests/results/runtime-evidence/app-worktree-result.* -text -whitespace
studio-tests/results/runtime-evidence/final-close-pressure/** -text -whitespace

# 本轮规范化CLI证据固定LF，保证Windows新checkout仍符合归档哈希；PNG保留二进制检测。
studio-tests/results/runtime-evidence/cli-comprehensive-2026-11-18/*.json text eol=lf
studio-tests/results/runtime-evidence/cli-comprehensive-2026-11-18/*.jsonl text eol=lf
studio-tests/results/runtime-evidence/cli-comprehensive-2026-11-18/*.md text eol=lf
studio-tests/results/runtime-evidence/cli-comprehensive-2026-11-18/*.txt text eol=lf
studio-tests/results/runtime-evidence/cli-gap-validation/** text=auto eol=lf
